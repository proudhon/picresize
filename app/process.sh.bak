#!/bin/bash

SIZE="$1"
RESIZE_DIM="$2"

rm ./original/* -f || true
rm ./resized/* -f || true

# Suppress unzip output
unzip -q ./originalzip/*.zip -d ./original/

ZIPFILE=./resizedzip/output-$(date +%Y-%m-%d-%H-%M).zip
OUTPUT="canvas.jpeg"

convert -size "$SIZE" canvas:white "$OUTPUT"

for image in ./original/*; do
  if [ -f "$image" ]; then
    filename=$(basename "$image")
    dimensions=$(identify -format "%w %h" "$image")
    width=$(echo $dimensions | cut -d' ' -f1)
    height=$(echo $dimensions | cut -d' ' -f2)

    if [ "$width" -ge "$height" ]; then
      max_dimension=$width
    else
      max_dimension=$height
    fi

    tmp_image=$(mktemp --suffix=$(echo "$filename" | sed 's/.*\(\.[^.]\+\)$/\1/'))

    if [ "$max_dimension" -gt $RESIZE_DIM ]; then
      convert "$image" -resize "$RESIZE_DIM"x"$RESIZE_DIM" "$tmp_image"
    else
      cp "$image" "$tmp_image"
    fi

    convert canvas.jpeg "$tmp_image" -gravity center -composite "./resized/$filename"
    rm "$tmp_image"
  fi
done

# Silence zip output
zip -q "$ZIPFILE" ./resized/*

# Echo ONLY the path
echo "$ZIPFILE"
